{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "skipLibCheck": true,
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true, "noEmit": true,
    "types": ["vite/client"], "allowImportingTsExtensions": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts"]
}
